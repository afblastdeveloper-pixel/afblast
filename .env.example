# AF Blast Frontend Environment Configuration (Single Domain)

# Awalan path untuk area staf (diawali "/", tanpa "/" di akhir, huruf kecil/angka/strip)
# Default: /staff
VITE_STAFF_BASE=/staff

# Backend API Endpoint URL
# Mendukung relatif same-origin (/api) atau absolut (http://localhost:4000)
VITE_API_URL=/api

# Telegram Recovery Bot Username (tanpa @)
VITE_TELEGRAM_BOT_USERNAME=AFBlastRecoveryBot

# Cloudflare Turnstile CAPTCHA (Single Domain, site key terpisah berdasarkan area path)
VITE_CAPTCHA_ENABLED=false
VITE_TURNSTILE_SITE_KEY_MEMBER=
VITE_TURNSTILE_SITE_KEY_STAFF=

# WhatsApp Gateway & Simulator Configuration (Local dev / testing)
WATSAP_MODE=sim
SIM_BASE_URL=http://localhost:4100
SIM_API_KEY=afblast_sim_secret_key_2026
SIM_WEBHOOK_SECRET=afblast_watsap_webhook_secret_key_2026
BACKEND_URL=http://localhost:4000
